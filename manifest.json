{
  "manifest_version": 3,
  "name": "googlepeel",
  "version": "1.0.0",
  "description": "Collects professor/faculty-related URLs from Google search results for academic research",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Collect Faculty URLs"
  }
}
