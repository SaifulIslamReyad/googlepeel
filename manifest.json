{
  "manifest_version": 3,
  "name": "googlepeel",
  "version": "1.0.0",
  "description": "Collects professor/faculty-related URLs from Google search results for academic research",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.startpage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.startpage.com/*"],
      "js": ["auto-trigger.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Collect Faculty URLs"
  }
}
